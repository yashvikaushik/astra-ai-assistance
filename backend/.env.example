# Server Port (Render sets this dynamically, or defaults to 5002)
PORT=5002

# Environment Mode
NODE_ENV=production

# Frontend Client URL (e.g. https://your-astra-app.vercel.app)
CLIENT_URL=https://your-astra-app.vercel.app

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.wbjibmb.mongodb.net/astra-ai-assistance

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Configuration
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_KEY=your_gemini_api_key_here
